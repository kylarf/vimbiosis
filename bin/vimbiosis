#!/bin/sh
set -eu

source_path=$0
while [ -L "$source_path" ]; do
  source_dir=$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)
  target=$(readlink "$source_path")
  case $target in
    /*) source_path=$target ;;
    *) source_path=$source_dir/$target ;;
  esac
done
package_dir=$(CDPATH= cd -- "$(dirname -- "$source_path")/.." && pwd)
launcher=$package_dir/python/launcher.py
case $(uname -s) in
  MINGW*|MSYS*)
    launcher=$(cygpath -m "$launcher")
    export MSYS2_ARG_CONV_EXCL='*'
    ;;
esac
exec python3 "$launcher" "$@"
